{
  "headers": [
    {
      "source": "/(formations|videos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "empreinte-bootcamp.vercel.app"
        }
      ],
      "destination": "https://www.bootcamp-empreinte.fr/$1",
      "permanent": true
    }
  ]
}
